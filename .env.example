# Set these on the server; do not commit the real .env or initial code.
SAI_ENV=production
SAI_PUBLIC_ORIGIN=https://your-sai-domain.example
# SAI_DB_PATH=/var/lib/sai/sai.db
# SAI_INITIAL_OPERATOR_CODE: optional secret supplied through the deployment environment.
# With local SQLite, an omitted code is generated once and saved beside the DB.
# Hosted PostgreSQL should receive a generated SAI_INITIAL_OPERATOR_CODE secret.
# The saved code is NOT reset when the service restarts.

# Vercel uses VERCEL_PROJECT_PRODUCTION_URL when SAI_PUBLIC_ORIGIN is omitted.
# SAI_BACKUP_DIR=/var/data/backups

# Hosted free deployment: keep the real value only in server secret settings.
# SAI_DATABASE_URL=postgresql://sai_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# SAI_DATABASE_SSL_ROOT_CERT=certs/supabase-prod-ca-2021.crt
